digraph G { graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.25",ranksep="0.35"]; node [shape=box,style="rounded,filled",fillcolor="#eef4fb",color="#406080",fontname="DejaVu Sans",fontsize=11]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=9]; PO [label="Buyer: draft PO"]; Approval [label="Purchase Manager: approve PO"]; GRN [label="Warehouse: receive goods"]; QC [label="QC inspector + manager: inspect / approve"]; Stock [label="Warehouse: post accepted / rejected stock"]; Invoice [label="Accounts: draft invoice"]; Match [label="Three-way match: PO + posted accepted stock + invoice"]; Finance [label="Finance: approve submitted invoice"]; Pay [label="Accounts: record payment"]; PO -> Approval -> GRN -> QC -> Stock -> Invoice -> Match -> Finance -> Pay; GRN -> Stock [label="QC exempt"]; }